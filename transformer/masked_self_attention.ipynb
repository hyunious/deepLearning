     "text": [
      "score:  tensor([[ 1.1897, -0.0442,  0.2964, -1.0341],\n",
      "        [ 0.5601, -0.7101, -0.1191, -0.3371],\n",
      "        [ 0.1481,  0.7270, -0.4270, -0.9904],\n",
      "        [ 1.0793, -0.5673, -1.6927,  0.5485]])\n",
      "tril:  tensor([[1., 0., 0., 0.],\n",
      "        [1., 1., 0., 0.],\n",
      "        [1., 1., 1., 0.],\n",
      "        [1., 1., 1., 1.]])\n",
      "scores:  tensor([[ 1.1897,    -inf,    -inf,    -inf],\n",
      "        [ 0.5601, -0.7101,    -inf,    -inf],\n",
      "        [ 0.1481,  0.7270, -0.4270,    -inf],\n",
      "        [ 1.0793, -0.5673, -1.6927,  0.5485]])\n"
     ]
    }
   ],
   "source": [
    "import torch\n",
    "\n",
    "\n",
    "scores = torch.randn(4, 4)\n",
    "print(\"score: \", scores)\n",
    "\n",
    "tril = torch.tril(torch.ones(4, 4), diagonal=0)\n",
    "print(\"tril: \", tril)\n",
    "\n",
    "\n",
    "scores = scores.masked_fill(tril == 0, float(\"-inf\"))\n",
    "print(\"scores: \", scores)"
   ]
  },
